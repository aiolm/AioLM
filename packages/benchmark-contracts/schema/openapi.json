{
  "openapi": "3.1.0",
  "info": {
    "title": "AioLM Benchmark Sharing API",
    "version": "1.1.0",
    "description": "Service-neutral contract. Server URL and authentication are supplied by the website integration. Retried uploads with an identical Idempotency-Key and payload return the same stored result; reuse with a different payload returns 409. POST /v1/benchmark-runs accepts a publication wrapper or a legacy bare submission with an empty description; legacy input does not bypass owner/permit checks. Original measurements and environment are immutable after acceptance; only the current description changes via expected_revision."
  },
  "paths": {
    "/v1/upload-sessions": {
      "post": {
        "operationId": "createUploadSession",
        "description": "Authenticated by owner proof (Authorization: Bearer 32-byte base64url secret). Creates a pending 5min session bound to submission/body/owner. Apply request limits before DB allocation.",
        "security": [
          {
            "ownerProof": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pending upload session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid owner proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "429": {
            "description": "Session-create limit 5/min/IP; honor Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/upload-sessions/{id}": {
      "get": {
        "operationId": "getUploadSession",
        "description": "Owner proof returns pending/verified/expired with expires_at; permit present only for authenticated verified status, expires within 5min and bound to session/submission/body/owner.",
        "security": [
          {
            "ownerProof": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadSessionPoll"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid owner proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "404": {
            "description": "Unknown session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/upload-sessions/{id}/verify": {
      "post": {
        "operationId": "verifyUploadSession",
        "description": "Called by the website Turnstile page with {token}. Server Siteverify checks hostname/action benchmark_publish and token single-use/expiry. Completion discloses neither owner credential nor benchmark body.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "token"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification accepted"
          },
          "400": {
            "description": "Invalid or reused token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/benchmark-runs": {
      "post": {
        "operationId": "submitBenchmark",
        "description": "Accepts wrapper or legacy body. Hashes EXACT incoming request bytes. Same ID+owner+body returns existing receipt 200 even without fresh permit or quota; wrong owner rejected; changed body 409; deleted submission with correct owner 410 submission_deleted. New creation validates permit and consumes it, writes run+chunks, charges quotas in ONE transaction, returns 201 receipt. Whole request UTF-8 <=4MiB; rows paged in chunks of 1000, at most 10000 rows.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "description": "Bearer 32-byte base64url management secret; server stores SHA256 hash only.",
            "schema": {
              "type": "string",
              "pattern": "^Bearer [A-Za-z0-9_-]{43}$"
            }
          },
          {
            "in": "header",
            "name": "X-Upload-Permit",
            "required": false,
            "description": "Single-use permit bound to session/submission/body/owner; accepted-request replay may omit it.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "./publication.schema.json"
                  },
                  {
                    "$ref": "./public-benchmark.schema.json"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Previously accepted identical submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "submission_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,200}$",
                      "maxLength": 200
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "maxLength": 2048
                    }
                  },
                  "required": [
                    "submission_id",
                    "id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "201": {
            "description": "Submission accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "submission_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,200}$",
                      "maxLength": 200
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "maxLength": 2048
                    }
                  },
                  "required": [
                    "submission_id",
                    "id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Bounds or DTO validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "401": {
            "description": "verification_required or ownership_missing; recoverable user-action blocks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "403": {
            "description": "Wrong owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key already used with a different payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "410": {
            "description": "submission_deleted is terminal and never retried",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; honor Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable; honor Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listBenchmarkRuns",
        "description": "Public list with keyset pagination default 25/max 100, filters model/hardware/method/workload, no misleading combined leaderboard. All public endpoints/pages no-store initially.",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "in": "query",
            "name": "model",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "in": "query",
            "name": "hardware",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "in": "query",
            "name": "method",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "in": "query",
            "name": "workload",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged public runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/benchmark-runs/{id}": {
      "get": {
        "operationId": "getBenchmarkRun",
        "description": "Public metadata/summary/description/revision with no owner info. Absent/hidden/deleted returns 404.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public run"
          },
          "404": {
            "description": "Absent, hidden, or deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteBenchmarkRun",
        "description": "Ownership locks the same anchor and removes payload/chunks/description/summary, retaining a minimal tombstone with submission ID/body hash/owner hash/public id; revokes sessions. Public read returns 404; accepted retry returns 410 submission_deleted and never dispatches again. Requires owner proof or a scoped management session with Origin and X-CSRF-Token for cookie auth. Local app deletion never calls this API automatically.",
        "security": [
          {
            "ownerProof": []
          },
          {
            "managementSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted; minimal tombstone retained"
          },
          "401": {
            "description": "Missing owner proof or management session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "404": {
            "description": "Absent, hidden, or already removed without a tombstone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "410": {
            "description": "Already deleted; accepted retry returns submission_deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/benchmark-runs/{id}/measurements": {
      "get": {
        "operationId": "getBenchmarkMeasurements",
        "description": "Rows paged in chunks of 1000 as {rows, next_cursor}.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged measurement rows"
          },
          "404": {
            "description": "Absent, hidden, or deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/benchmark-runs/{id}/description": {
      "patch": {
        "operationId": "editBenchmarkDescription",
        "description": "Body {description_md, expected_revision}; matching scoped session or owner proof; conflict 409. Only current description changes; initial request bytes/hash remain immutable.",
        "security": [
          {
            "ownerProof": []
          },
          {
            "managementSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description_md": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "description_md",
                  "expected_revision"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Description updated"
          },
          "409": {
            "description": "Stale expected_revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/management-sessions": {
      "post": {
        "operationId": "createManagementSession",
        "description": "Body {recovery_code}; verifies owner and establishes result-scoped 30min HttpOnly/Secure/SameSite=Strict cookie; returns {id, csrf_token}. Invalid-management limit 10/min/IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recovery_code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "recovery_code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Scoped management session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "csrf_token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "csrf_token"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Invalid recovery code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getManagementSession",
        "description": "Protected; returns current scoped management info including hidden state.",
        "security": [
          {
            "managementSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current management info"
          },
          "401": {
            "description": "Missing session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteManagementSession",
        "description": "Clears the management session cookie.",
        "responses": {
          "204": {
            "description": "Session cleared"
          }
        }
      }
    },
    "/v1/benchmark-runs/{id}/reports": {
      "post": {
        "operationId": "reportBenchmarkRun",
        "description": "Body {reason, token}; bounded 2000 chars and server Turnstile validation action benchmark_report. Report limit 3/hour/IP.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "token": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "required": [
                  "reason",
                  "token"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Report accepted"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ownerProof": {
        "type": "http",
        "scheme": "bearer",
        "description": "32-byte base64url management secret; server stores SHA256 hash only."
      },
      "managementSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "management_session",
        "description": "Result-scoped 30min session plus X-CSRF-Token header."
      }
    },
    "schemas": {
      "ServiceError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "UploadSessionRequest": {
        "type": "object",
        "properties": {
          "submission_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "submission_id",
          "body_sha256"
        ],
        "additionalProperties": false
      },
      "UploadSessionResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "verification_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "session_id",
          "verification_url",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "UploadSessionPoll": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "expired"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "permit": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "expires_at"
        ],
        "additionalProperties": false
      }
    }
  }
}
