{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiolm:benchmark:public:1",
  "title": "AioLM public benchmark submission",
  "description": "A reviewed public schema-4 snapshot for openai-chat-serving@5. Null means unknown. Local paths, raw arguments, diagnostics and persistent hardware identifiers are excluded. Model status sha256 requires a hash; unidentified and multipart require null. Cold Prompt uses corpus version 2, a fresh run nonce, no workload warmup and unique actual request input hashes. The eight metrics are first-output latency, per-request prompt processing, per-request generation speed, time per output token, total reported token throughput, output byte throughput, batch end-to-end duration and sampled owned process-tree memory. Token metrics depend on engine-reported usage; unavailable evidence remains null.",
  "$ref": "#/$defs/serving",
  "$defs": {
    "gpu": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "vram_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "driver": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "integrated": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "vendor",
        "vram_mb",
        "driver",
        "integrated"
      ],
      "additionalProperties": false
    },
    "servingRuntime": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "backend": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "build": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "variant": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "plugin_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "name",
        "version",
        "backend",
        "build",
        "variant",
        "plugin_version"
      ],
      "additionalProperties": false
    },
    "recordedSetting": {
      "type": "object",
      "properties": {
        "target": {
          "enum": [
            "launch",
            "request"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "maxLength": 64
          },
          "maxItems": 8
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "maxLength": 64
        },
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^(?!-)[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "maxItems": 64
            }
          ]
        },
        "unit": {
          "enum": [
            "tokens",
            "bytes",
            "MiB",
            "GiB",
            "threads",
            "layers",
            "count",
            "ratio",
            "bits",
            "percent",
            null
          ]
        },
        "role": {
          "enum": [
            "context.total_tokens",
            "context.per_sequence_tokens",
            "context.per_request_kv_tokens",
            "concurrency.capacity",
            null
          ]
        }
      },
      "required": [
        "target",
        "scope",
        "name",
        "value",
        "unit",
        "role"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "const": "request"
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "maxItems": 0
              },
              "role": {
                "type": "null"
              }
            },
            "oneOf": [
              {
                "properties": {
                  "name": {
                    "const": "temperature"
                  },
                  "value": {
                    "const": 0
                  },
                  "unit": {
                    "const": null
                  }
                }
              },
              {
                "properties": {
                  "name": {
                    "const": "max_tokens"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 128
                  },
                  "unit": {
                    "const": "tokens"
                  }
                }
              },
              {
                "properties": {
                  "name": {
                    "const": "stream"
                  },
                  "value": {
                    "const": true
                  },
                  "unit": {
                    "const": null
                  }
                }
              },
              {
                "properties": {
                  "name": {
                    "const": "stream_options.include_usage"
                  },
                  "value": {
                    "const": true
                  },
                  "unit": {
                    "const": null
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "servingExecution": {
      "type": "object",
      "properties": {
        "topology": {
          "enum": [
            "owned",
            "attached",
            "unknown"
          ]
        },
        "memory_scope": {
          "enum": [
            "owned_process_tree",
            "owned_root_process",
            "unavailable"
          ]
        },
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recordedSetting"
          },
          "maxItems": 128
        }
      },
      "required": [
        "topology",
        "memory_scope",
        "settings"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "topology": {
                "enum": [
                  "attached",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "memory_scope": {
                "const": "unavailable"
              }
            }
          }
        }
      ]
    },
    "servingWorkload": {
      "type": "object",
      "properties": {
        "corpus": {
          "type": "string",
          "enum": [
            "code_python",
            "code_mixed",
            "novel_ko",
            "novel_en",
            "novel_ja"
          ]
        },
        "corpus_version": {
          "type": "integer",
          "const": 2
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bytes": {
                "type": "integer",
                "minimum": 256,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "concurrencies": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "warmup": {
          "const": false
        },
        "request_usage": {
          "type": "boolean"
        },
        "cache_policy": {
          "const": "cold_prompt"
        },
        "prompt_nonce": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "corpus",
        "corpus_version",
        "inputs",
        "max_output_tokens",
        "concurrencies",
        "repetitions",
        "warmup",
        "request_usage",
        "cache_policy",
        "prompt_nonce"
      ],
      "additionalProperties": false
    },
    "servingModel": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "sha256",
            "unidentified",
            "multipart"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ],
          "description": "Optional declared GGUF fields and file-matched Hugging Face download origin. Null or absent means unavailable. Publisher is the repository namespace, not quantized_by. Weight encoding does not imply identical tensors or quality. Local paths are excluded.",
          "properties": {
            "format": {
              "type": "string",
              "const": "GGUF"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "architecture": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "size_label": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "quantization": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "file_type": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 65535
            },
            "quantized_by": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "repository": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 257,
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "base_models": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 257,
                "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "artifact": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._ -]{0,127}/)*[A-Za-z0-9][A-Za-z0-9._ -]*\\.[gG][gG][uU][fF]$"
            },
            "source": {
              "type": "string",
              "enum": [
                "gguf",
                "huggingface",
                "gguf+huggingface"
              ]
            }
          },
          "required": [
            "format",
            "name",
            "architecture",
            "size_label",
            "quantization",
            "file_type",
            "quantized_by",
            "repository",
            "base_models",
            "artifact",
            "source"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "type": "object",
                "required": [
                  "artifact"
                ],
                "properties": {
                  "artifact": {
                    "type": "string"
                  }
                }
              },
              "then": {
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "source": {
                    "enum": [
                      "huggingface",
                      "gguf+huggingface"
                    ]
                  }
                }
              }
            }
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "gguf",
            "hf-safetensors",
            "mlx",
            "unknown"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "huggingface"
            },
            "repository": {
              "type": "string",
              "maxLength": 257,
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "kind",
            "repository",
            "revision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "sha256",
        "size_bytes",
        "format"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "sha256"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sha256": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "sha256": {
            "type": "null"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "enum": [
                  "hf-safetensors",
                  "mlx",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "metadata": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "servingEnvironment": {
      "type": ["object", "null"],
      "properties": {
        "os": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "arch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "cpu": {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "logical_cores": {
              "type": "integer",
              "minimum": 0
            },
            "physical_cores": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Physical cores, separate from the logical_cores thread count. Absent or null when the measuring machine did not report one; never derived from the thread count."
            }
          },
          "required": [
            "name",
            "logical_cores"
          ],
          "additionalProperties": false
        },
        "system_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "installed_gpus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gpu"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "execution": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "cpu",
                "selected",
                "automatic",
                "unknown"
              ]
            },
            "selected_gpus": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/gpu"
              },
              "minItems": 0,
              "maxItems": 256
            },
            "selection_complete": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "selected_gpus",
            "selection_complete"
          ],
          "additionalProperties": false
        },
        "scope": {
          "const": "aiolm_host"
        }
      },
      "required": [
        "os",
        "arch",
        "cpu",
        "installed_gpus",
        "execution",
        "scope"
      ],
      "additionalProperties": false
    },
    "servingRow": {
      "type": "object",
      "properties": {
        "input_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1048576
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "input_sha256_by_request": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "first_output_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "e2e_ms": {
          "type": "number",
          "minimum": 0
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reported_prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reported_completion_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prefill_tokens_per_second": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "decode_tokens_per_second": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tpot_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "usage_status": {
          "enum": [
            "complete",
            "partial",
            "missing",
            "invalid"
          ]
        },
        "finish_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "stop",
              "length",
              "content_filter",
              "tool_calls",
              "other",
              "not_reported"
            ]
          },
          "minItems": 1,
          "maxItems": 64
        },
        "peak_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timing_source": {
          "const": "client"
        },
        "failed": {
          "const": false
        }
      },
      "required": [
        "input_bytes",
        "max_output_tokens",
        "concurrency",
        "repetition",
        "input_sha256_by_request",
        "first_output_ms",
        "e2e_ms",
        "output_bytes",
        "reported_prompt_tokens",
        "reported_completion_tokens",
        "prefill_tokens_per_second",
        "decode_tokens_per_second",
        "tpot_ms",
        "usage_status",
        "finish_reasons",
        "peak_memory_bytes",
        "timing_source",
        "failed"
      ],
      "additionalProperties": false
    },
    "serving": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 4
        },
        "submission_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "app_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "method": {
          "type": "object",
          "properties": {
            "id": {
              "const": "openai-chat-serving"
            },
            "version": {
              "type": "integer",
              "const": 5
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "workload": {
          "$ref": "#/$defs/servingWorkload"
        },
        "model": {
          "$ref": "#/$defs/servingModel"
        },
        "runtime": {
          "$ref": "#/$defs/servingRuntime"
        },
        "environment": {
          "$ref": "#/$defs/servingEnvironment"
        },
        "execution": {
          "$ref": "#/$defs/servingExecution"
        },
        "measurements": {
          "type": "object",
          "properties": {
            "status": {
              "const": "complete"
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/servingRow"
              },
              "minItems": 1,
              "maxItems": 10000
            }
          },
          "required": [
            "status",
            "rows"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "submission_id",
        "app_version",
        "method",
        "workload",
        "model",
        "runtime",
        "environment",
        "execution",
        "measurements"
      ],
      "additionalProperties": false
    }
  }
}
