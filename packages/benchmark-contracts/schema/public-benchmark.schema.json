{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiolm:benchmark:public:1",
  "title": "AioLM public benchmark submission v1",
  "description": "A reviewed public snapshot. Null means unknown. Local paths, raw arguments, diagnostics and persistent hardware identifiers are excluded. Model status sha256 requires a hash; unidentified and multipart require null.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "app_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256,
      "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
    },
    "method": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string",
          "const": "cold-prompt-serving"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "properties": {
        "corpus": {
          "type": "string",
          "enum": [
            "code_python",
            "code_mixed",
            "novel_ko",
            "novel_en",
            "novel_ja"
          ]
        },
        "corpus_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "corpus_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_lengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "maxItems": 64
        },
        "generation_length": {
          "type": "integer",
          "minimum": 1
        },
        "batch_sizes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 0,
          "maxItems": 64
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "warmup": {
          "type": "boolean"
        }
      },
      "required": [
        "corpus",
        "corpus_version",
        "corpus_sha256",
        "prompt_lengths",
        "generation_length",
        "batch_sizes",
        "repetitions",
        "warmup"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "sha256",
            "unidentified",
            "multipart"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ],
          "description": "Optional declared GGUF fields and file-matched Hugging Face download origin. Null or absent means unavailable. Publisher is the repository namespace, not quantized_by. Weight encoding does not imply identical tensors or quality. Local paths are excluded.",
          "properties": {
            "format": {
              "type": "string",
              "const": "GGUF"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "architecture": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "size_label": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "quantization": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "file_type": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 65535
            },
            "quantized_by": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "repository": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 257,
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "base_models": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 257,
                "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "artifact": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._ -]{0,127}/)*[A-Za-z0-9][A-Za-z0-9._ -]*\\.[gG][gG][uU][fF]$"
            },
            "source": {
              "type": "string",
              "enum": [
                "gguf",
                "huggingface",
                "gguf+huggingface"
              ]
            }
          },
          "required": [
            "format",
            "name",
            "architecture",
            "size_label",
            "quantization",
            "file_type",
            "quantized_by",
            "repository",
            "base_models",
            "artifact",
            "source"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "type": "object",
                "required": [
                  "artifact"
                ],
                "properties": {
                  "artifact": {
                    "type": "string"
                  }
                }
              },
              "then": {
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "source": {
                    "enum": [
                      "huggingface",
                      "gguf+huggingface"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "sha256"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sha256": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "sha256": {
            "type": "null"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "llama.cpp"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "backend": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "build": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "name",
        "version",
        "backend",
        "build"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "os": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "arch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "cpu": {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "logical_cores": {
              "type": "integer",
              "minimum": 0
            },
            "physical_cores": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Physical cores, separate from the logical_cores thread count. Absent or null when the measuring machine did not report one; never derived from the thread count."
            }
          },
          "required": [
            "name",
            "logical_cores"
          ],
          "additionalProperties": false
        },
        "system_memory_bytes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "installed_gpus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gpu"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "execution": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "cpu",
                "selected",
                "automatic",
                "unknown"
              ]
            },
            "selected_gpus": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/gpu"
              },
              "minItems": 0,
              "maxItems": 256
            },
            "selection_complete": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "selected_gpus",
            "selection_complete"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "os",
        "arch",
        "cpu",
        "installed_gpus",
        "execution"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "context_size": {
          "type": "integer",
          "minimum": 0
        },
        "parallel": {
          "type": "integer",
          "minimum": 0
        },
        "settings": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "gpu_layers": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": -1
            },
            "threads": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": -1
            },
            "threads_batch": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": -1
            },
            "flash_attention": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "cache_type_k": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "cache_type_v": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "split_mode": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
            },
            "tensor_split": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 0,
              "maxItems": 256
            }
          },
          "required": [
            "gpu_layers",
            "threads",
            "threads_batch",
            "flash_attention",
            "cache_type_k",
            "cache_type_v",
            "split_mode",
            "tensor_split"
          ],
          "additionalProperties": false
        },
        "effective_args": {
          "description": "llama-server options the measured run was started with, in order, as separate tokens. Options carrying a path, address or credential are removed with their values; the pattern rejects any remaining token that could hold one.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "context_size",
        "parallel",
        "settings"
      ],
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "cancelled",
            "failed"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "status",
        "rows"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "submission_id",
    "app_version",
    "method",
    "workload",
    "model",
    "runtime",
    "environment",
    "execution",
    "measurements"
  ],
  "additionalProperties": false,
  "$defs": {
    "gpu": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "vram_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "driver": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[^\\\\/:@\\u0000-\\u001f\\u007f]+$"
        },
        "integrated": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "vendor",
        "vram_mb",
        "driver",
        "integrated"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "generation_length": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "repetition": {
          "type": "integer",
          "minimum": 1
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "ttft_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tpot_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pp_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tg_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "e2e_ms": {
          "type": "number",
          "minimum": 0
        },
        "total_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "timing_source": {
          "type": "string",
          "enum": [
            "server",
            "client"
          ]
        },
        "failed": {
          "type": "boolean"
        }
      },
      "required": [
        "prompt_tokens",
        "generation_length",
        "concurrency",
        "repetition",
        "completion_tokens",
        "cached_tokens",
        "ttft_ms",
        "tpot_ms",
        "pp_tps",
        "tg_tps",
        "e2e_ms",
        "total_tps",
        "peak_memory_bytes",
        "timing_source",
        "failed"
      ],
      "additionalProperties": false
    }
  }
}
