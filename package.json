{
  "name": "aiolm",
  "private": true,
  "workspaces": [
    "packages/benchmark-contracts"
  ],
  "version": "0.1.15",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build:contracts": "npm run build --workspace @aiolm/benchmark-contracts",
    "test:contracts": "npm run test --workspace @aiolm/benchmark-contracts",
    "dev": "npm run build:contracts && vite",
    "build": "npm run build:contracts && tsc && vite build",
    "lint": "eslint src scripts tests packages/benchmark-contracts vite.config.ts",
    "lint:fix": "eslint src scripts tests packages/benchmark-contracts vite.config.ts --fix",
    "test:advanced-settings": "node --experimental-strip-types tests/direct/test-advanced-settings.ts",
    "test:tuning": "node --experimental-strip-types tests/direct/test-tuning-validation.ts",
    "test:sse": "node --experimental-strip-types tests/direct/test-sse.ts",
    "test:chat-stream": "node --experimental-strip-types tests/direct/test-chat-stream.ts",
    "test:endpoint-adapters": "node --experimental-strip-types tests/direct/test-endpoint-adapters.ts",
    "test:chat-history": "node --experimental-strip-types tests/direct/test-chat-history.ts",
    "test:document-context": "node --experimental-strip-types tests/direct/test-document-context.ts",
    "test:document-index": "node --experimental-strip-types tests/direct/test-document-index.ts",
    "test:discover-utils": "node --experimental-strip-types tests/direct/test-discover-utils.ts",
    "test:developer-utils": "node --experimental-strip-types tests/direct/test-developer-utils.ts",
    "test:mcp-utils": "node --experimental-strip-types tests/direct/test-mcp-utils.ts",
    "test:runtime-utils": "node --experimental-strip-types tests/direct/test-runtime-utils.ts",
    "test:config-schema": "node --experimental-strip-types tests/direct/test-config-schema.ts",
    "test:config-save-queue": "node --experimental-strip-types tests/direct/test-config-save-queue.ts",
    "test:scan-generation": "node --experimental-strip-types tests/direct/test-scan-generation.ts",
    "test:vision-state": "node --experimental-strip-types tests/direct/test-vision-state.ts",
    "test:tuning-async": "node --experimental-strip-types tests/direct/test-tuning-async.ts",
    "test:model-row-events": "node --experimental-strip-types tests/direct/test-model-row-events.ts",
    "test:model-selection-paths": "node --experimental-strip-types tests/direct/test-model-selection-paths.ts",
    "test:project-store": "node --experimental-strip-types tests/direct/test-project-store.ts",
    "test:lifecycle-utils": "node --experimental-strip-types tests/direct/test-lifecycle-utils.ts",
    "test:storage": "node --experimental-strip-types tests/direct/test-storage.ts",
    "test:models-css": "node --experimental-strip-types tests/direct/test-models-css.ts",
    "test:run-direct-tests": "node --experimental-strip-types tests/direct/test-run-direct-tests.ts",
    "test:direct": "node --experimental-strip-types tests/direct/run.ts",
    "test:unit": "npm run build:contracts && npm run test:contracts && npm run test:run-direct-tests && npm run test:direct && npm run test:coverage",
    "test": "npm run test:unit",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run build:contracts && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "build:cli": "node scripts/build-cli.mjs",
    "package:tauri": "npm run build:cli && npm run build && node scripts/package-tauri.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:i18n": "node --experimental-strip-types tests/direct/test-i18n.ts",
    "test:ui": "npm run build:contracts && vitest run"
  },
  "dependencies": {
    "@aiolm/benchmark-contracts": "file:packages/benchmark-contracts",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
