diff --git a/src/runtime/runtime.c b/src/runtime/runtime.c
index a073f60..b0f0d45 100644
--- a/src/runtime/runtime.c
+++ b/src/runtime/runtime.c
@@ -965,12 +965,17 @@ int rm_recursive_callback(const char* path, const struct stat* stat, const int t
     return 0;
 };

+// nftw() must be allowed to hold at least one directory open: musl (which the static runtime links) returns 0
+// without visiting anything when fd_limit <= 0, so the extracted directory was never removed. glibc clamps the
+// value to 1. Directories nested deeper than this limit are not descended by musl.
+#define RM_RECURSIVE_FD_LIMIT 64
+
 bool rm_recursive(const char* const path) {
     // FTW_DEPTH: perform depth-first search to make sure files are deleted before the containing directories
     // FTW_MOUNT: prevent deletion of files on other mounted filesystems
     // FTW_PHYS: do not follow symlinks, but report symlinks as such; this way, the symlink targets, which might point
     //           to locations outside path will not be deleted accidentally (attackers might abuse this)
-    int rv = nftw(path, &rm_recursive_callback, 0, FTW_DEPTH | FTW_MOUNT | FTW_PHYS);
+    int rv = nftw(path, &rm_recursive_callback, RM_RECURSIVE_FD_LIMIT, FTW_DEPTH | FTW_MOUNT | FTW_PHYS);

     return rv == 0;
 }
